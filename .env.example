# Скопируйте этот файл в .env и заполните значения.
# .env не должен попадать в систему контроля версий.

# Секретный ключ Django. Сгенерируйте новый:
# python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# Режим разработки: 1 — включён, 0 — выключен для production.
DJANGO_DEBUG=1

# Список хостов через запятую.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],testserver

# Доверенные origin для CSRF (например, https://ideamix.example).
DJANGO_CSRF_TRUSTED_ORIGINS=

# Редирект на HTTPS и HSTS включаются автоматически при DEBUG=0.
# DJANGO_SECURE_SSL_REDIRECT=1

# Модерация: 1 — блокировать мат в публикуемом контенте, 0 — отключить фильтр.
IDEAMIX_PROFANITY_FILTER=1

# Необязательно: настройки почты.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# DJANGO_DEFAULT_FROM_EMAIL=IdeaMix <no-reply@ideamix.local>
